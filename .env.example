# ==========================================================
# CodeTrack: Environment Variables Example
# ==========================================================
# Copy this file to .env and provide your Supabase credentials:
# cp .env.example .env

# Your Supabase Project URL (e.g. https://your-project.supabase.co)
VITE_SUPABASE_URL=

# Your Supabase Public Anon Key (Found in Supabase Settings > API)
# NEVER put your secret service_role key here!
VITE_SUPABASE_ANON_KEY=
