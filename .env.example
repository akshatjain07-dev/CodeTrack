# ==========================================================
# CodeTrack: Environment Variables Template
# ==========================================================
# Instructions:
# 1. Copy this template to .env:
#    cp .env.example .env
# 2. Fill in your project's Supabase URL and Public Anon Key below.
# 3. NEVER commit your real .env file or publish secret keys to Git!

# ----------------------------------------------------------
# SUPABASE CLIENT CREDENTIALS (FRONTEND PUBLIC)
# ----------------------------------------------------------
# Found in: Supabase Dashboard > Project Settings > API
# - Project URL: Unique HTTPS endpoint for your Supabase project
# - Project API Keys: Use the "anon" (public) key ONLY.
#
# SECURITY WARNING:
# NEVER place your Supabase "service_role" secret key or your
# Google OAuth Client Secret here. Those keys bypass Row Level
# Security and must NEVER be bundled into client-side JavaScript!
# ----------------------------------------------------------

# Your Supabase Project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Your Supabase Anon / Public Key (Safe for browser clients)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-token-here

# ----------------------------------------------------------
# REQUIRED REDIRECT URLS (For Reference)
# ----------------------------------------------------------
# Local Development:
#   Site URL:             http://localhost:5173
#   OAuth Redirect URL:   http://localhost:5173/auth/callback
#
# Production (e.g. Vercel):
#   Site URL:             https://your-production-domain.vercel.app
#   OAuth Redirect URL:   https://your-production-domain.vercel.app/auth/callback
#
# Supabase Google Provider Callback URI (Must be registered in Google Cloud Console):
#   https://your-project-ref.supabase.co/auth/v1/callback
# ----------------------------------------------------------
